        "target": "ES2020",
        "module": "commonjs",
        "moduleResolution": "node",
        "outDir": "./dist",
        "strict": false,
        "esModuleInterop": true,
        "skipLibCheck": true
    },
    "include": [
        "demo/**/*",
        "gateway_core/src/**/*",
        "products/substrate/src/**/*",
        "integrations/gateway_bridge/**/*",
        "voice_service/src/**/*"
    ]
}